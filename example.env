# ── RavenHub configuración (copia a .env: cp example.env .env) ──

# Postgres (compose.dev usa estas credenciales)
POSTGRES_USER=ravenhub
POSTGRES_PASSWORD=ravenhub-dev
POSTGRES_DB=ravenhub
RAVENHUB_DSN=postgres://ravenhub:ravenhub-dev@localhost:5435/ravenhub

# Clave maestra de cifrado de secretos en reposo (AES-256-GCM).
# NO dejes un placeholder público: `make up` genera una aleatoria si .env no
# existe (o si esta línea está vacía). Para producción: openssl rand -hex 32.
RAVENHUB_MASTER_KEY=

# Token admin (bootstrap). Vacío + RAVENHUB_DEV=1 → el Hub genera uno para dev
# y lo imprime en el log. Vacío SIN RAVENHUB_DEV → el Hub NO arranca: una
# credencial admin impresa en docker logs no puede ser el default de producción.
RAVENHUB_ADMIN_TOKEN=
# RAVENHUB_DEV=1

# API
# Loopback por defecto: el hub de dev usa credenciales reales y HTTP. Si
# necesitas probar agentes desde la LAN, cambia a :8085 de forma consciente y
# protege el puerto (firewall/TLS); nunca lo expongas a Internet.
RAVENHUB_LISTEN=127.0.0.1:8085
RAVENHUB_LOG_LEVEL=info
# Solo dev: el canal log escribe el cuerpo completo (por defecto body_len)
# RAVENHUB_LOG_CHANNEL_BODY=1

# Cola y contrapresión
RAVENHUB_WORKERS=8
RAVENHUB_MAX_QUEUE_SOFT=5000    # encima de esto: 429 para low/normal (shedding)
RAVENHUB_MAX_QUEUE_HARD=7500    # encima de esto: 503 para todos
RAVENHUB_MAX_QUEUE_PROJECT=2000 # cuota dura por proyecto: un tenant no bloquea a todos
RAVENHUB_RATE_PER_MIN=60        # bucket de entrada por proyecto
RAVENHUB_RATE_BURST=10
RAVENHUB_LEASE=2m               # 'delivering' sin latido → reaper lo reencola
RAVENHUB_SYNC_WAIT=8s           # deadline de ?sync=true

# Retención: barrido horario del worker; 0 = desactivado
RAVENHUB_RETENTION_MESSAGES=720h   # mensajes TERMINALES: 30 días
RAVENHUB_RETENTION_AUDIT=2160h     # auditoría: 90 días

# Backup cifrado (make backup). Sin clave, make backup FALLA por defecto:
# un dump con mensajes/contactos no puede quedar en claro. Genera el par con
# `age-keygen -o ~/.config/ravenhub-backup/age-identity.txt` y pon aquí solo
# la clave PÚBLICA (age1...). En dev sin age: BACKUP_ALLOW_PLAINTEXT=1 make backup
# AGE_PUBLIC_KEY=age1...

# Seed (make seed) — credenciales de tus cuentas reales, nunca en el repo.
# Recomendado: muévelas a .env.seed (600, ignorado); `ravenhub import` las
# carga y el runtime del Hub no las recibe.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=

# Watchdog (bot bootstrap INDEPENDIENTE de la cola)
# En dev: `make watchdog` (contra :8085; sin bot, alertas solo al log).
# WATCHDOG_HEALTHZ_URL=https://notify.tudominio.com/healthz
# WATCHDOG_BOT_TOKEN=
# WATCHDOG_CHAT_ID=
# WATCHDOG_INTERVAL=300
